# 自架 Firecrawl 的 compose 設定。複製成 .env 再改密碼：
#   cp .env.example .env
# .env 不進版控；POSTGRES_PASSWORD 至少 32 字隨機字元。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-at-least-32-random-characters
POSTGRES_DB=postgres

# dc-bridge 的 config.json 要填同一個埠：http://127.0.0.1:3002
FIRECRAWL_PORT=3002

# 這台只做單篇抓取，不需要預設的併發量。
NUM_WORKERS_PER_QUEUE=2
MAX_CONCURRENT_JOBS=2
BROWSER_POOL_SIZE=2
MAX_CONCURRENT_PAGES=2
BLOCK_MEDIA=true

# RabbitMQ 只在 compose 內部網路；帳密不對外。密碼請用英數字（要放進 URL）。
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=replace-with-another-random-password
